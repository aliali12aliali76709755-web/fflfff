# توكن بوت الصانع من @BotFather (إلزامي)
MAKER_TOKEN=

# رقمك في تيليجرام (ID): يظهر لك زر «لوحة الإدارة» وتصلك إشعارات المنصة.
# إن تركته فارغاً يصبح أول من يرسل /start للصانع هو المدير.
ADMIN_ID=

# اسم الصانع الظاهر في رسالة الترحيب
BRAND=صانع البوتات
BRAND_EN=Bot Maker

# روابط اختيارية تظهر في رسالة البداية وقائمة «المزيد»
UPDATES_URL=
PRIVACY_URL=
GUIDE_URL=

# اللغة عند عدم معرفة لغة المستخدم: ar أو en
DEFAULT_LANG=ar

# ── موقع الويب المرتبط بالبوتات ──
# منفذ خادم الويب الداخلي (0 = إيقاف المواقع ولوحات الويب)
WEB_PORT=8080
# الرابط العام الذي يصل به الناس إلى هذا الخادم، بلا مسار بعد اسم النطاق، مثل: https://bots.example.com
# • فارغ: المواقع تعمل على هذا الجهاز فقط (http://localhost:8080) ولا تظهر أزرارها في البوتات.
# • https: يظهر زر الموقع في البوتات ويفتح داخل تيليجرام.
PUBLIC_URL=

# نفق https تلقائي حين يكون PUBLIC_URL فارغاً: تشغّل المنصة برنامج cloudflared لتحصل على رابط https مؤقت،
# فتفتح مواقع البوتات داخل تيليجرام من جهازك مباشرة. عند أول تشغيل يُنزَّل cloudflared من صفحة إصدارات
# Cloudflare الرسمية على GitHub إلى data/tools (نحو 40MB). الرابط يتغير مع كل تشغيل. للإيقاف: AUTO_TUNNEL=0
AUTO_TUNNEL=0

# فرق التوقيت عن UTC بالساعات: لعرض التواريخ ولموعد التقرير اليومي (3 = سوريا وتركيا)
TZ_HOURS=3

# حد عدد البوتات لكل مستخدم (0 = بلا حد)
MAX_BOTS_PER_USER=0

# زر «إنشاء فوري عبر BotFather» (يظهر فقط إن فعّلت وضع إدارة البوتات للصانع في BotFather)
MANAGED_BOTS=1

# مفتاح خدمة ocr.space المجانية (يُستخدم لقراءة الصور حين لا يكون Tesseract مثبتاً). سجّل مفتاحك من ocr.space لرفع الحد اليومي.
OCR_SPACE_KEY=helloworld

# لرفع ملفات حتى 2GB شغّل خادم Bot API محلياً ثم فعّل التالي:
# LOCAL_API=1
# BOT_API_BASE=http://127.0.0.1:8081/bot
# BOT_API_FILE_BASE=http://127.0.0.1:8081/file/bot

# قاعدة البيانات (الافتراضي SQLite داخل مجلد data). مثال PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/forge
